# Normalize line endings to LF in the repository and on checkout.
# Keeps Prettier's `endOfLine: "lf"` (see .prettierrc) happy on every platform,
# including Windows where `core.autocrlf` is often enabled.
* text=auto eol=lf

# Windows-only scripts must keep CRLF so they stay runnable.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never convert or diff as text.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.avif  binary
*.ico   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.eot   binary
*.pdf   binary
*.zip   binary
*.mp4   binary
